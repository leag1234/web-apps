<section class="toolbar">
    <section class="box-tabs">
        <div class="extra left"></div>
        <%= tabsmarkup %>
        <div class="extra right"></div>
    </section>
    <section class="box-controls" role="tabpanel">
        <section class="panel static">
            <div class="group no-mask small">
                <div class="elset">
                    <span class="btn-slot" id="slot-btn-save" data-layout-name="toolbar-save"></span>
                </div>
                <div class="elset">
                    <span class="btn-slot" id="slot-btn-print"></span>
                </div>
            </div>
            <div class="separator long"></div>
            <div class="group small">
                <div class="elset">
                    <span class="btn-slot split" id="slot-btn-undo"></span>
                    <span class="btn-slot" id="slot-btn-redo"></span>
                </div>
            </div>
            <div class="separator long"></div>
        </section>
        <section class="box-panels">
            <section class="panel" data-tab="home" role="tabpanel" aria-labelledby="home">
                <div class="group group-clipboard" data-group="clipboard">
                    <span class="btn-slot text x-huge" id="slot-btn-paste"></span>
                    <div class="elset-column elx-rows3">
                        <div class="elset">
                            <span class="btn-slot" id="slot-btn-cut"></span>
                        </div>
                        <div class="elset">
                            <span class="btn-slot" id="slot-btn-copy"></span>
                        </div>
                        <div class="elset">
                            <span class="btn-slot" id="slot-btn-copystyle"></span>
                        </div>
                    </div>
                </div>
                <div class="separator long"></div>
                <div class="group small" data-group="font" data-launcher="font">
                    <div class="elset font-attr-top display-flex-row-center">
                        <span class="btn-slot float-left" id="slot-field-fontname"></span>
                        <span class="btn-slot float-left" id="slot-field-fontsize"></span>
                        <span class="btn-slot float-left" id="slot-btn-incfont"></span>
                        <span class="btn-slot float-left" id="slot-btn-decfont"></span>
                    </div>
                    <div class="elset font-attr">
                        <span class="btn-slot" id="slot-btn-bold"></span>
                        <span class="btn-slot" id="slot-btn-italic"></span>
                        <span class="btn-slot" id="slot-btn-underline"></span>
                        <span class="btn-slot split" id="slot-btn-borders"></span>
                        <span class="btn-slot split" id="slot-btn-fillparag"></span>
                        <span class="btn-slot split" id="slot-btn-fontcolor"></span>
                    </div>
                </div>
                <div class="separator long"></div>
                <div class="group small" data-group="alignment" data-launcher="alignment">
                    <div class="elset">
                        <span class="btn-slot split-small" id="slot-btn-top"></span>
                        <span class="btn-slot split-small" id="slot-btn-middle"></span>
                        <span class="btn-slot split-small" id="slot-btn-bottom"></span>
                        <span class="btn-slot split" id="slot-btn-text-orient"></span>
                    </div>
                    <div class="elset">
                        <span class="btn-slot split-small" id="<% if (!isRTL) { %>slot-btn-align-left<% } else { %>slot-btn-align-right<% } %>"></span>
                        <span class="btn-slot split-small" id="slot-btn-align-center"></span>
                        <span class="btn-slot split-small" id="<% if (!isRTL) { %>slot-btn-align-right<% } else { %>slot-btn-align-left<% } %>"></span>
                        <span class="btn-slot split-small" id="slot-elx-indent-dec"></span>
                        <span class="btn-slot split-small" id="slot-elx-indent-inc"></span>
                    </div>
                </div>
                <div class="group small">
                    <div class="elset">
                        <span class="btn-slot text" id="slot-btn-wrap"></span>
                    </div>
                    <div class="elset">
                        <span class="btn-slot text split" id="slot-btn-merge"></span>
                    </div>
                </div>
                <div class="group elx-hidden-group">
                    <span class="btn-slot split" id="slot-btn-changecase"></span>
                    <span class="btn-slot" id="slot-btn-strikeout"></span>
                    <span class="btn-slot split" id="slot-btn-subscript"></span>
                    <span class="btn-slot split-small" id="slot-btn-align-just"></span>
                    <span class="btn-slot split" id="slot-btn-direction"></span>
                </div>
                <div class="separator long"></div>
                <div class="group small" data-group="number" data-launcher="number">
                    <div class="elset display-flex-row-center">
                        <span class="btn-slot" id="slot-btn-format" style="min-width: 110px; flex-grow: 1;"></span>
                    </div>
                    <div class="elset">
                        <span class="btn-slot split-large" id="slot-btn-currency"></span>
                        <span class="btn-slot split-small" id="slot-btn-percents"></span>
                        <span class="btn-slot split-small" id="slot-btn-comma"></span>
                        <span class="btn-slot split-small" id="slot-btn-digit-inc"></span>
                        <span class="btn-slot" id="slot-btn-digit-dec"></span>
                    </div>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="styles">
                    <span class="btn-slot text x-huge" id="slot-btn-condformat"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-table-tpl"></span>
                </div>
                <div class="separator long invisible"></div>
                <div class="group small flex field-styles" id="slot-field-styles" style="width: 300px; min-width: 148px;" data-group-width="300px" data-group="cellstyles" data-collapse-first="1" data-collapse-icon="#btn-big-elx-cell-styles"></div>
                <div class="separator long"></div>
                <div class="group" data-group="cells">
                    <span class="btn-slot text x-huge" id="slot-btn-cell-ins"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-cell-del"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-cell-format"></span>
                </div>
                <div class="separator long"></div>
                <div class="group small elx-rows3" data-group="editing">
                    <div class="elset">
                        <span class="btn-slot text split" id="slot-btn-formula"></span>
                    </div>
                    <div class="elset">
                        <span class="btn-slot text split" id="slot-btn-fill-num"></span>
                    </div>
                    <div class="elset">
                        <span class="btn-slot text split" id="slot-btn-clear"></span>
                    </div>
                </div>
                <div class="group">
                    <span class="btn-slot text x-huge" id="slot-elx-sort-filter"></span>
                    <span class="btn-slot text x-huge" id="slot-elx-find-select"></span>
                </div>
                <div class="group elx-hidden-group">
                    <span class="btn-slot split slot-sortdesc"></span>
                    <span class="btn-slot slot-sortasc"></span>
                    <span class="btn-slot split slot-btn-setfilter"></span>
                    <span class="btn-slot slot-btn-clear-filter"></span>
                    <span class="btn-slot split" id="slot-btn-named-range"></span>
                    <span class="btn-slot" id="slot-btn-replace"></span>
                    <span class="btn-slot" id="slot-btn-select-all"></span>
                </div>
            </section>
            <section class="panel" data-tab="ins" role="tabpanel" aria-labelledby="ins">
                <div class="group" data-group="tables">
                    <span class="btn-slot text x-huge slot-add-pivot"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-instable"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="illustrations">
                    <span class="btn-slot text x-huge" id="slot-btn-insimage"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-insshape"></span>
                    <span class="btn-slot text x-huge" id="slot-elx-ins-icons"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-inssmartart"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="charts" data-launcher="charts">
                    <span class="btn-slot text x-huge" id="slot-btn-insrecommend"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-inschart"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="sparklines">
                    <span class="btn-slot text x-huge" id="slot-btn-inssparkline"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="filters">
                    <span class="btn-slot text x-huge" id="slot-btn-insslicer"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="links">
                    <span class="btn-slot text x-huge" id="slot-btn-inshyperlink"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-smartpicker"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="comments">
                    <span class="btn-slot text x-huge slot-comment"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="text">
                    <span class="btn-slot text x-huge" id="slot-btn-instext"></span>
                    <span class="btn-slot text x-huge slot-editheader"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-instextart"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="symbols">
                    <span class="btn-slot text x-huge" id="slot-btn-insequation"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-inssymbol"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="cellcontrols">
                    <span class="btn-slot text x-huge" id="slot-btn-inscheckbox"></span>
                </div>
            </section>
            <section class="panel" data-tab="layout" role="tabpanel" aria-labelledby="layout">
                <div class="group" data-group="themes">
                    <span class="btn-slot text x-huge" id="slot-btn-colorschemas"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="pagesetup" data-launcher="pagesetup">
                    <span class="btn-slot text x-huge" id="slot-btn-pagemargins"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-pageorient"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-pagesize"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-printarea"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-pagebreak"></span>
                    <span class="btn-slot text x-huge slot-editheader"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-printtitles"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="scaletofit" data-launcher="pagesetup">
                    <span class="btn-slot text" id="slot-btn-scale"></span>
                </div>
                <div class="separator long"></div>
                <div class="group small" data-group="sheetoptions" data-launcher="pagesetup">
                    <div class="elset">
                        <span class="btn-slot text" id="slot-chk-print-gridlines"></span>
                    </div>
                    <div class="elset">
                        <span class="btn-slot text" id="slot-chk-print-headings"></span>
                    </div>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="sheetdirection">
                    <span class="btn-slot text x-huge" id="slot-btn-rtl-sheet"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="arrange">
                    <span class="btn-slot text x-huge" id="slot-img-movefrwd"></span>
                    <span class="btn-slot text x-huge" id="slot-img-movebkwd"></span>
                    <span class="btn-slot text x-huge" id="slot-img-align"></span>
                    <span class="btn-slot text x-huge" id="slot-img-group"></span>
                    <span class="btn-slot text x-huge" id="slot-shapes-merge"></span>
                </div>
            </section>
            <section class="panel" data-tab="formula" role="tabpanel" aria-labelledby="formula">
                <div class="group" data-group="functionlibrary">
                    <span class="btn-slot text x-huge" id="slot-btn-additional-formula"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-autosum"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-recent"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-financial"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-logical"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-text"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-datetime"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-lookup"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-math"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-more"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="definednames">
                    <span class="btn-slot text x-huge" id="slot-btn-named-range-huge"></span>
                </div>
                <div class="separator long"></div>
                <div class="group small" data-group="formulaauditing">
                    <div class="elset">
                    <span class="btn-slot text" id="slot-btn-trace-prec"></span>
                    <span class="btn-slot text" id="slot-btn-remove-arrows"></span>
                    </div>
                    <div class="elset">
                    <span class="btn-slot text" id="slot-btn-trace-dep"></span>
                    <span class="btn-slot text" id="slot-btn-show-formulas"></span>
                    </div>
                </div>
                <div class="group" data-group="formulaauditing">
                    <span class="btn-slot text x-huge" id="slot-btn-watch-window"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="calculation">
                    <span class="btn-slot text x-huge" id="slot-btn-calculate"></span>
                </div>
            </section>
            <section class="panel" data-tab="data" role="tabpanel" aria-labelledby="data">
                <div class="group" data-group="gettransform">
                    <span class="btn-slot text x-huge" id="slot-btn-data-from-text"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="queries">
                    <span class="btn-slot text x-huge" id="slot-btn-data-external-links"></span>
                </div>
                <div class="separator long"></div>
                <div class="group small" data-group="sortfilter">
                    <div class="elset">
                    <span class="btn-slot split slot-sortdesc"></span>
                    </div>
                    <div class="elset">
                    <span class="btn-slot slot-sortasc"></span>
                    </div>
                </div>
                <div class="group" data-group="sortfilter">
                    <span class="btn-slot text x-huge" id="slot-btn-custom-sort"></span>
                </div>
                <div class="group small">
                    <div class="elset">
                        <span class="btn-slot split slot-btn-setfilter"></span>
                    </div>
                    <div class="elset">
                        <span class="btn-slot slot-btn-clear-filter"></span>
                    </div>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="datatools">
                    <span class="btn-slot text x-huge" id="slot-btn-text-column"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-rem-duplicates"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-data-validation"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="forecast">
                    <span class="btn-slot text x-huge" id="slot-btn-goal-seek"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="outline">
                    <span class="btn-slot text x-huge" id="slot-btn-group"></span>
                    <span class="btn-slot text x-huge" id="slot-btn-ungroup"></span>
                </div>
                <div class="separator long"></div>
                <div class="group" data-group="analyze">
                    <span class="btn-slot text x-huge" id="slot-btn-solver"></span>
                </div>
            </section>
        </section>
    </section>
</section>
